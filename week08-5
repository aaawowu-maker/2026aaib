#include <stdio.h>

int main()
{
    int a[20]; // 宣告一個可以存放 20 個整數的陣列
    int N = 0; // 用來記錄實際輸入了幾個數字

    // 第一個 for 迴圈：讀取輸入
    for(int i=0; i<20; i++) {
        scanf("%d", &a[i]); // 讀取一個數字存入 a[i]

        if (a[i] == 0) break; // 如果輸入的是 0，就跳出迴圈，不再輸入

        N++; // 每成功讀入一個非 0 的數字，數量 N 就加 1
    }

    // 第二個 for 迴圈：反向輸出
    // 從 N-1 (最後一個存入的數字索引) 開始，一路往回數到 0
    for(int i = N - 1; i >= 0; i--) {
        printf("%d ", a[i]); // 印出數字，後面加個空格
    }

    printf("\n"); // 最後換行

    return 0;
}
